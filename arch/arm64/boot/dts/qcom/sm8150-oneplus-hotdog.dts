// SPDX-License-Identifier: BSD-3-Clause
/*
 * Devicetree for the OnePlus 7T Pro (hotdog, project 19801).
 *
 * The board is the OnePlus 7 Pro's (guacamole): OnePlus's downstream
 * kernel builds both from the same sm8150-oem.dtsi (panel, S6SY761 touch
 * on QUP SE17, UFS, USB) and differs only in charger and battery
 * properties, which mainline doesn't describe. ABL picks the appended DTB
 * by qcom,msm-id: given a DTB without one, it answered `fastboot boot`
 * with OKAY and stayed in fastboot (Android 12 ABL). The phone's ABL
 * reports SoC 339 (SM8150); downstream also builds the board on SM8150P
 * (361), so both are listed at v2. board-id <8 0> is downstream hotdog's.
 *
 * Based on sm8150-oneplus-guacamole.dts:
 * Copyright (c) 2021, Caleb Connolly <caleb@connolly.tech>
 * Reserved regions from OnePlus's downstream sm8150.dtsi and sm8150-oem.dtsi.
 *
 * Enabled: the panel as ABL left it (simple-framebuffer), UFS, USB
 * peripheral, touch (S6SY761), the fuel gauge (BQ27411), the power and
 * volume keys and the alert slider.
 */

/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "sm8150-oneplus-common.dtsi"

/* Redone below, with guard pages, where this phone's modem expects it. */
/delete-node/ &rmtfs_mem;

/ {
	model = "OnePlus 7T Pro";
	compatible = "oneplus,hotdog", "qcom,sm8150";

	qcom,msm-id = <QCOM_ID_SM8150 0x20000>, <361 0x20000>; /* SM8150, SM8150P v2 */
	qcom,board-id = <8 0>;

	/*
	 * The three-position alert slider: one line per position, from the
	 * vendor tri-state-key node (gpio_key1 = TLMM 27, gpio_key2 = TLMM 134,
	 * gpio_key3 = TLMM 125, no internal bias). The order follows the
	 * OnePlus 6's slider in sdm845-oneplus-common.dtsi, whose vendor node
	 * lists its lines the same way (key1 bottom, key3 top). Reported as
	 * ABS_SND_PROFILE, the event the input core defines for such switches.
	 * All three lines are in the PDC's wake map, so a move wakes the phone
	 * from suspend and the new profile applies at once.
	 */
	alert-slider {
		compatible = "gpio-keys";
		label = "Alert slider";

		pinctrl-0 = <&alert_slider_default>;
		pinctrl-names = "default";

		switch-top {
			label = "Silent";
			linux,input-type = <EV_ABS>;
			linux,code = <ABS_SND_PROFILE>;
			linux,input-value = <SND_PROFILE_SILENT>;
			gpios = <&tlmm 125 GPIO_ACTIVE_LOW>;
			linux,can-disable;
			wakeup-source;
		};

		switch-middle {
			label = "Vibrate";
			linux,input-type = <EV_ABS>;
			linux,code = <ABS_SND_PROFILE>;
			linux,input-value = <SND_PROFILE_VIBRATE>;
			gpios = <&tlmm 134 GPIO_ACTIVE_LOW>;
			linux,can-disable;
			wakeup-source;
		};

		switch-bottom {
			label = "Ring";
			linux,input-type = <EV_ABS>;
			linux,code = <ABS_SND_PROFILE>;
			linux,input-value = <SND_PROFILE_RING>;
			gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
			linux,can-disable;
			wakeup-source;
		};
	};

	aliases {
		display0 = &framebuffer0;
		hsuart0 = &uart13;
	};

	/*
	 * Goodix optical sensor under the panel (stock goodix_fp node). Its SPI
	 * bus (QUP0 SE3, gpio144-147) belongs to the Goodix trusted application
	 * in QSEE; Linux drives its supply switch (gpio101), reset (gpio131) and
	 * interrupt (gpio118), and keeps the bus's pins and clocks on for QSEE,
	 * as stock's enabled qupv3_se3_spi node with no child did. spi3 itself
	 * stays disabled: Linux never drives that serial engine.
	 */
	fingerprint {
		compatible = "oneplus,hotdog-udfps";
		interrupts-extended = <&tlmm 118 IRQ_TYPE_EDGE_RISING>;
		reset-gpios = <&tlmm 131 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vreg_fp_vdd>;

		clocks = <&gcc GCC_QUPV3_WRAP0_S3_CLK>,
			 <&gcc GCC_QUPV3_WRAP_0_M_AHB_CLK>,
			 <&gcc GCC_QUPV3_WRAP_0_S_AHB_CLK>;
		clock-names = "se", "m-ahb", "s-ahb";

		pinctrl-0 = <&fp_irq_default &fp_reset_default &qup_spi3_default>;
		pinctrl-names = "default";
	};

	/*
	 * The volume keys are PM8150 GPIO6 (up) and GPIO7 (down), active low with
	 * the PMIC's pull-up at the 1.8 V vin-1, as in the vendor gpio_keys node.
	 * Sampled on the phone on 2026-11-15: GPIO6 low only while Volume Up was
	 * held, GPIO7 only while Volume Down was. The vendor tree also gives
	 * PON RESIN KEY_VOLUMEDOWN; it stays disabled (as pm8150.dtsi leaves
	 * it) so one press can't report twice.
	 */
	gpio-keys {
		compatible = "gpio-keys";
		label = "Volume keys";
		autorepeat;

		pinctrl-0 = <&vol_up_n>, <&vol_down_n>;
		pinctrl-names = "default";

		key-vol-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm8150_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};

		key-vol-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pm8150_gpios 7 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	/* Sets the RF test cable state in SMEM for the modem (rf_v3 = no cable). */
	project-info {
		compatible = "oneplus,sm8150-project-info";
	};

	/*
	 * Downstream's /dev/qseecom for the vendor fingerprint HAL, with its
	 * shared buffers in the qseecom carve-out. Its module refuses every
	 * trusted application and listener that its allow-lists (module
	 * parameters, set by the device package) do not name.
	 */
	qseecom-compat {
		compatible = "omamobile,qseecom-compat";
		memory-region = <&qseecom_mem>;
	};

	/*
	 * The sensor's supply switch (stock fp_vdd_init / fp_vdd_dis_init). It
	 * stays off until goodix-fp's device is opened.
	 */
	vreg_fp_vdd: regulator-fp-vdd {
		compatible = "regulator-fixed";
		regulator-name = "fp_vdd";
		gpio = <&tlmm 101 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&fp_vdd_default>;
		pinctrl-names = "default";
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "display0";

		/* The panel as ABL left it (cont_splash_region, 1440x3120). */
		framebuffer0: framebuffer@9c000000 {
			compatible = "simple-framebuffer";
			reg = <0 0x9c000000 0 (1440 * 3120 * 4)>;
			width = <1440>;
			height = <3120>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * The touchscreen's 1.8 V: a load switch from S4A whose enable, GPIO 119,
	 * is held high by its pull-up (tp_1v8_active), as downstream leaves it.
	 */
	ts_vdd_1p8: regulator-ts-vdd {
		compatible = "regulator-fixed";
		regulator-name = "ts_vdd_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vreg_s4a_1p8>;
	};

	/*
	 * Downstream regions mainline's sm8150.dtsi leaves as System RAM.
	 * Firmware owns some of them at runtime, so keep Linux out of all.
	 */
	reserved-memory {
		/*
		 * Downstream xbl_aop_mem is 0x85e00000-0x85f40000. Mainline's
		 * xbl_mem, aop_mem and aop_cmd_db cover all of it except this gap.
		 */
		xbl_aop_gap_mem: memory@85e40000 {
			reg = <0 0x85e40000 0 0xc0000>;
			no-map;
		};

		/* The tail of downstream removed_regions, past mainline tz_mem. */
		removed_mem: memory@89b00000 {
			reg = <0 0x89b00000 0 0x1c00000>;
			no-map;
		};

		/* Downstream cont_splash_region: ABL's display buffers. */
		splash_mem: memory@9c000000 {
			reg = <0 0x9c000000 0 0x2400000>;
			no-map;
		};

		/* OnePlus's bootloader_log_mem. */
		bootloader_log_mem: memory@9fff7000 {
			reg = <0 0x9fff7000 0 0x9000>;
			no-map;
		};

		cdsp_sec_mem: memory@a4c00000 {
			reg = <0 0xa4c00000 0 0x3c00000>;
			no-map;
		};

		/*
		 * Stock's ramoops region. ramoops_probe() rounds each zone size
		 * down to a power of two and gives the dmesg records what is
		 * left, so the layout is: six 0x40000 dmesg records at +0,
		 * the console at +0x180000, pmsg at +0x1c0000 and ftrace at
		 * +0x3c0000. OnePlus's downstream kernel keeps a 0x1000
		 * devinfo zone in the same region, and its console starts
		 * 0x1000 lower (the crash-dump table names it KMSG, at
		 * 0xa997f008), so the two kernels' zones don't line up.
		 */
		ramoops@a9800000 {
			compatible = "ramoops";
			reg = <0 0xa9800000 0 0x400000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			ftrace-size = <0x40000>;
			pmsg-size = <0x200000>;
			ecc-size = <0>;
		};

		/* OnePlus's param_mem and mtp_mem. */
		param_mem: memory@ac200000 {
			reg = <0 0xac200000 0 0xc00000>;
			no-map;
		};

		/*
		 * Downstream allocates rmtfs at runtime (qcom,rmtfs_sharedmem,
		 * 2 MiB with qcom,guard-memory). On the OnePlus 7 Pro it always
		 * ends up at 0xf2901000 (sm8150-oneplus-common.dtsi). Same
		 * region here, plus the 4 KiB guard page on each side so no
		 * Linux allocation sits next to the XPU-protected range.
		 */
		rmtfs_mem: memory@f2900000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0 0xf2900000 0 0x202000>;
			no-map;

			qcom,client-id = <1>;
			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
			qcom,use-guard-pages;
		};
	};
};

/*
 * This board's apps RSC never answers an RPMh read: refuse them rather
 * than lose both active TCSes to two reads that never complete.
 */
&apps_rsc {
	qcom,no-read-support;
};

/*
 * `reboot bootloader` / `reboot recovery`: the same PON spare codes as
 * downstream's qpnp_pon_set_restart_reason() (gen2: reason << 1), which ABL reads.
 */
&pon {
	mode-bootloader = <0x2>;
	mode-recovery = <0x1>;
};

&pm8150_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio6";
		function = "normal";
		power-source = <1>;
		bias-pull-up;
		input-enable;
	};

	vol_down_n: vol-down-n-state {
		pins = "gpio7";
		function = "normal";
		power-source = <1>;
		bias-pull-up;
		input-enable;
	};
};

&gmu {
	status = "okay";
};

&gpu {
	status = "okay";
};

/* From the phone's own vendor partition (/vendor/firmware/a640_zap.*). */
&gpu_zap_shader {
	firmware-name = "qcom/sm8150/oneplus/hotdog/a640_zap.mbn";
};

/*
 * Downstream qupv3_se7_i2c: the Awinic AW8697 LRA haptics driver (stock
 * aw8697_haptic@5A, reset on GPIO 116, interrupt on GPIO 24). The chip
 * measured the actuator at 175-176 Hz; OnePlus ships waveform sets for
 * 166 to 174 Hz.
 */
&i2c7 {
	clock-frequency = <400000>;
	status = "okay";

	vibrator@5a {
		compatible = "awinic,aw8697";
		reg = <0x5a>;
		interrupts-extended = <&tlmm 24 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&haptics_irq_default &haptics_reset_default>;
		pinctrl-names = "default";
		awinic,f0-hz = <170>;
	};
};

/* Downstream qupv3_se8_i2c: fuel gauge and OnePlus's fast-charge MCU. */
&i2c8 {
	clock-frequency = <100000>;
	status = "okay";

	/*
	 * Downstream calls it bq27541, but its driver also detects a BQ27411
	 * (device type 0x0421) and the classic bq27541 register map reads
	 * garbage on this phone.
	 */
	fuel-gauge@55 {
		compatible = "ti,bq27411";
		reg = <0x55>;
	};
};

&qupv3_id_0 {
	status = "okay";
};

&qupv3_id_2 {
	status = "okay";
};

&i2c17 {
	clock-frequency = <400000>;
	status = "okay";

	/*
	 * Downstream hotdog: 3.0 V from L17A for the analog side, 1.8 V switched
	 * by GPIO 119 (tp_1v8_active), reset GPIO 54 held by tp_rst_active.
	 */
	touchscreen@48 {
		compatible = "samsung,s6sy761";
		reg = <0x48>;
		interrupt-parent = <&tlmm>;
		interrupts = <122 IRQ_TYPE_LEVEL_LOW>;
		avdd-supply = <&vreg_l17a_3p0>;
		vdd-supply = <&ts_vdd_1p8>;

		touchscreen-size-x = <1440>;
		touchscreen-size-y = <3120>;
		samsung,ear-detect;

		pinctrl-names = "default";
		pinctrl-0 = <&tp_irq_active &tp_rst_active &tp_1v8_active>;
	};
};

/*
 * Remote processors, squashed .mbn from the phone's modem partition. A missing
 * file just leaves the remoteproc offline. The modem doesn't boot by itself
 * (auto_boot off): rmtfs starts it once it serves the EFS partitions.
 * The ELF images are relocatable and each one spans its whole region
 * (adsp 0x1e00000, modem 0x9600000, cdsp/slpi 0x1400000).
 */
&remoteproc_adsp {
	firmware-name = "qcom/sm8150/oneplus/hotdog/adsp.mbn";
	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm8150/oneplus/hotdog/cdsp.mbn";
	status = "okay";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm8150/oneplus/hotdog/modem.mbn";
	status = "okay";
};

/*
 * SLPI boots, but its sensor_process user PD hits its watchdog ~40 s later
 * ("USER-PD DOG detects stalled initialization"): nothing serves it the
 * sensor registry yet. Its SSR then collides with any modem recovery and
 * the SoC ends in crash dump mode. Off until sensors get their own step.
 */
&remoteproc_slpi {
	firmware-name = "qcom/sm8150/oneplus/hotdog/slpi.mbn";
	status = "disabled";
};

/*
 * Display: Samsung 1440x3120 AMOLED, command mode, DSC with two encoders on
 * one 4-lane DSI link (downstream topology <2 2 1>). Pins and supply from
 * downstream dsi_samsung_oneplus_dsc_cmd: reset GPIO 6, TE GPIO 8, vddio
 * from L14A; the other rails are switched by the panel itself.
 */
&mdss {
	status = "okay";
};

&mdss_mdp {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3c_1p2>;
	status = "okay";

	panel@0 {
		compatible = "samsung,oneplus-dsc";
		reg = <0>;

		vddio-supply = <&vreg_l14a_1p8>;
		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&panel_reset_default &mdss_te_default>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l5a_0p875>;
	status = "okay";
};

/*
 * WCN3990 rails from downstream's icnss node: cx-mx L1A (0.752 V), xo L7A
 * (1.8 V), rfa L2C (1.304 V), ch0 L11C (3.104-3.312 V; downstream BT asks for
 * 3.312 V on the same LDO). No ch1. MSA is wlan_mem, the same 0x180000 at
 * 0x8bc00000 as downstream's qcom,wlan-msa-fixed-region. Its firmware
 * (wlanmdsp.mbn) is loaded by the modem over tqftpserv; the board data
 * is looked up as variant oneplus_hotdog in ath10k's board-2.bin.
 */
&vreg_l11c_3p3 {
	regulator-min-microvolt = <3104000>;
};

&wifi {
	vdd-0.8-cx-mx-supply = <&vreg_l1a_0p75>;
	vdd-1.8-xo-supply = <&vreg_l7a_1p8>;
	vdd-1.3-rfa-supply = <&vreg_l2c_1p3>;
	vdd-3.3-ch0-supply = <&vreg_l11c_3p3>;

	qcom,calibration-variant = "oneplus_hotdog";

	status = "okay";
};

/*
 * WCN3990 Bluetooth on QUP SE13 as a 4-wire UART (downstream
 * qupv3_se13_4uart, wake IRQ on RX GPIO 46), powered from the same rails as
 * Wi-Fi. Firmware is stock's bluetooth_a image: crbtfw21.tlv and the NVM
 * picked by board ID (crnv21.bXX, else crnv21.bin), as Android does.
 */
&uart13 {
	/delete-property/ interrupts;
	interrupts-extended = <&intc GIC_SPI 585 IRQ_TYPE_LEVEL_HIGH>,
			      <&tlmm 46 IRQ_TYPE_EDGE_FALLING>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&qup_uart13_default>;
	pinctrl-1 = <&qup_uart13_sleep>;

	status = "okay";

	bluetooth: bluetooth {
		compatible = "qcom,wcn3998-bt";
		vddio-supply = <&vreg_l1a_0p75>;
		vddxo-supply = <&vreg_l7a_1p8>;
		vddrf-supply = <&vreg_l2c_1p3>;
		vddch0-supply = <&vreg_l11c_3p3>;
		max-speed = <3200000>;
		firmware-name = "crnv21", "crbtfw21.tlv";
	};
};

&tlmm {
	alert_slider_default: alert-slider-default-state {
		pins = "gpio27", "gpio125", "gpio134";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	panel_reset_default: panel-reset-default-state {
		pins = "gpio6";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	/* Fingerprint pins as stock's fp_irq_init, fp_reset_init, fp_vdd_*. */
	fp_irq_default: fp-irq-default-state {
		pins = "gpio118";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-disable;
	};

	fp_reset_default: fp-reset-default-state {
		pins = "gpio131";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	/* Stock pulls down while off; the regulator drives it while on. */
	fp_vdd_default: fp-vdd-default-state {
		pins = "gpio101";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	/* Haptics pins as stock's aw_irq and aw_reset (whose names are swapped). */
	haptics_irq_default: haptics-irq-default-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-disable;
	};

	haptics_reset_default: haptics-reset-default-state {
		pins = "gpio116";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	mdss_te_default: mdss-te-default-state {
		pins = "gpio8";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	qup_uart13_default: qup-uart13-default-state {
		pins = "gpio43", "gpio44", "gpio45", "gpio46";
		function = "qup13";
		drive-strength = <2>;
		bias-disable;
	};

	/* Pulls from downstream's qupv3_se13 sleep states. */
	qup_uart13_sleep: qup-uart13-sleep-state {
		pinmux {
			pins = "gpio43", "gpio44", "gpio45", "gpio46";
			function = "gpio";
		};

		pinconf-cts-rts {
			pins = "gpio43", "gpio44";
			bias-pull-down;
		};

		pinconf-tx-rx {
			pins = "gpio45", "gpio46";
			bias-pull-up;
		};
	};
};
